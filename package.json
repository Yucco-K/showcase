{
	"name": "portfolio-v3",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite --port 5173",
		"build": "tsc && vite build",
		"lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0 --fix",
		"preview": "vite preview",
		"predeploy": "npm run build && cp dist/index.html dist/404.html",
		"deploy": "gh-pages -d dist",
		"vercel-build": "npm run build",
		"vercel-deploy": "vercel --prod",
		"db:seed": "tsx --env-file=.env scripts/seed.ts",
		"test:setup-admin": "tsx --env-file=.env scripts/setup-test-admin.ts",
		"export:notion": "tsx --env-file=.env scripts/export-to-notion.ts",
		"export:notion:template": "tsx --env-file=.env scripts/export-to-notion-with-template.ts",
		"export:notion:all": "tsx --env-file=.env scripts/export-all-docs-to-notion.ts",
		"notion:list-pages": "tsx --env-file=.env scripts/get-notion-pages.ts",
		"notion:fix-user-guide": "tsx --env-file=.env scripts/export-user-guide-fixed.ts",
		"notion:export-tech-ja": "tsx --env-file=.env scripts/export-technical-doc-ja.ts",
		"notion:export-obsidian-workspace": "tsx --env-file=.env scripts/export-obsidian-workspace-to-notion.ts",
		"export:obsidian": "tsx --env-file=.env scripts/export-obsidian-to-notion.ts",
		"type-check": "tsc --noEmit",
		"test": "playwright test",
		"test:ui": "playwright test --ui",
		"sync:gorse-products": "ts-node scripts/sync-gorse-products.ts",
		"ci": "npm run type-check && npm run lint && npm run build && npm run test",
		"security:scan": "docker run -v $(pwd):/path zricethezav/gitleaks:latest detect --source /path -v -c /path/.gitleaks.toml",
		"security:scan-uncommitted": "docker run -v $(pwd):/path zricethezav/gitleaks:latest protect --source /path -v -c /path/.gitleaks.toml",
		"security:install": "pip install pre-commit && pre-commit install",
		"security:check": "pre-commit run --all-files",
		"prepare": "command -v pre-commit > /dev/null && pre-commit install || echo 'pre-commit not installed, skipping hook setup'"
	},
	"dependencies": {
		"@mantine/core": "^8.1.3",
		"@mantine/hooks": "^8.1.3",
		"@mantine/tiptap": "^8.2.1",
		"@notionhq/client": "^4.0.1",
		"@react-three/drei": "^10.7.7",
		"@react-three/fiber": "^9.6.1",
		"@stripe/stripe-js": "^7.4.0",
		"@supabase/supabase-js": "^2.111.0",
		"@tabler/icons-react": "^3.46.0",
		"@tiptap/extension-placeholder": "^3.29.2",
		"@tiptap/pm": "^3.29.2",
		"@tiptap/react": "^3.29.2",
		"@tiptap/starter-kit": "^3.29.2",
		"@tryfabric/martian": "^1.2.4",
		"@vercel/node": "^5.9.0",
		"chart.js": "^4.5.1",
		"framer-motion": "^12.43.0",
		"gorsejs": "^0.5.0",
		"node-fetch": "^3.0.0",
		"openai": "^5.10.2",
		"react": "^19.2.8",
		"react-chartjs-2": "^5.3.1",
		"react-dom": "^19.2.8",
		"react-hook-form": "^7.83.0",
		"react-icons": "^5.7.0",
		"react-markdown": "^10.1.0",
		"react-router-dom": "^7.18.2",
		"remark-gfm": "^4.0.1",
		"styled-components": "^6.4.4",
		"three": "^0.185.1",
		"zod": "^3.25.76"
	},
	"devDependencies": {
		"@eslint/js": "^9.30.1",
		"@playwright/test": "^1.62.0",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^4.6.0",
		"dotenv": "^17.4.2",
		"esbuild": "^0.28.1",
		"eslint": "^9.31.0",
		"eslint-plugin-react-hooks": "^5.2.0",
		"eslint-plugin-react-refresh": "^0.5.3",
		"eslint-plugin-unused-imports": "^4.4.1",
		"gh-pages": "^6.3.0",
		"globals": "^16.3.0",
		"playwright": "^1.54.1",
		"tsx": "^4.20.3",
		"typescript": "5.9.3",
		"typescript-eslint": "^8.65.0",
		"vite": "^7.0.4",
		"wait-on": "^8.0.3"
	},
	"description": "ドキュメント一式は以下の専用リポジトリで管理しています。",
	"main": "index.js",
	"directories": {
		"test": "tests"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Yucco-K/showcase.git"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"bugs": {
		"url": "https://github.com/Yucco-K/showcase/issues"
	},
	"homepage": "https://github.com/Yucco-K/showcase#readme"
}
